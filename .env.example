# Clerk → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Supabase → Project Settings → API (database only; auth is Clerk)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only, never expose

# Comma-separated Google emails that are auto-approved as admins (can create invite links)
ADMIN_EMAILS=you@gmail.com

# Krillion numbering: any one known game number + the date it was played,
# and the timezone where the daily puzzle resets.
KRILLION_REFERENCE_GAME=129
KRILLION_REFERENCE_DATE=2026-11-22
KRILLION_TIMEZONE=America/Toronto

# Players need at least this many games to be ranked on the overall board (others show as provisional)
MIN_GAMES_FOR_RANKING=3

# Optional: used for invite links (defaults to the request host)
# NEXT_PUBLIC_SITE_URL=https://krillion-leaderboard.vercel.app
