#!/bin/sh
# Blocks commits that contain real secrets (Clerk, Supabase, Vercel, GitHub, AWS keys, JWTs, private keys)
# or that add a real .env file. Enabled via `git config core.hooksPath .githooks` (npm install does this).

fail=0

# Real env files must never be committed (only the .env.example template).
envfiles=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env' | grep -v '\.env\.example$')
if [ -n "$envfiles" ]; then
  echo "✋ refusing to commit env files:"; echo "$envfiles" | sed 's/^/   /'
  fail=1
fi

pattern='(sk|pk|rk)_(test|live)_[A-Za-z0-9]{16,}|sb_(secret|publishable)_[A-Za-z0-9_-]{16,}|sbp_[A-Za-z0-9]{20,}|eyJ[A-Za-z0-9_-]{15,}\.eyJ[A-Za-z0-9_-]{15,}|gh[pousr]_[A-Za-z0-9]{30,}|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY'
hits=$(git diff --cached -U0 --no-color | grep -E '^\+' | grep -v '^+++' | grep -nE "$pattern")
if [ -n "$hits" ]; then
  echo "✋ refusing to commit: these added lines look like real secrets:"
  echo "$hits" | cut -c1-120 | sed 's/^/   /'
  fail=1
fi

if [ "$fail" -ne 0 ]; then
  echo "put real keys in .env.local (git-ignored), not in committed files."
  exit 1
fi
